---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import TourCard from '@/components/TourCard.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import { destinations } from '@/data/destinations';
import { toursFor } from '@/data/tours';
---

<Base title="Tours" description="Island hopping, land, city and evening tours in El Nido, Coron, Port Barton and Puerto Princesa at promo rates.">
  <PageHero
    image="tours/el-nido/tour-c/hidden-beach.webp"
    alt="Hidden Beach in El Nido, seen from above"
    title="Every tour we run."
    lede="Joining tours at promo rates, lunch included on most. Private tours for your group on request."
  />

  <section class="tl section" data-nav-theme="dark">
    <div class="container">
      <nav class="tl__jump" aria-label="Jump to destination" data-reveal>
        {destinations.map((d) => <a href={`#${d.slug}`}>{d.name}</a>)}
      </nav>

      {destinations.map((d) => {
        const list = toursFor(d.slug);
        return (
          <div class="tl__group" id={d.slug}>
            <header class="tl__head" data-reveal-group>
              <h2 class="display display-m" data-reveal>{d.name}</h2>
              <p class="lede" data-reveal>{d.short}</p>
              <a href={`/destinations/${d.slug}`} class="link-arrow" data-reveal>About {d.name} <span class="arrow">→</span></a>
            </header>
            <div class="tl__grid" data-reveal-group>
              {list.map((t) => (
                <div data-reveal><TourCard tour={t} sizes="(min-width: 960px) 30vw, (min-width: 640px) 46vw, 100vw" /></div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <FinalCTA title="Not sure which tour?" text="Tell us your dates and we will suggest a plan." cta="Ask us" image="tours/port-barton/barton-a/exotic-island.webp" alt="Exotic Island, Port Barton" />
</Base>

<style>
  .tl__jump { display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; margin-bottom: clamp(3rem, 6vw, 5rem); font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; }
  .tl__jump a { padding-block: .4rem; border-bottom: 1px solid transparent; transition: border-color .3s; }
  .tl__jump a:hover { border-color: var(--navy); }
  .tl__group { padding-top: clamp(2rem, 4vw, 3rem); margin-bottom: clamp(4rem, 8vw, 7rem); border-top: 1px solid var(--navy); scroll-margin-top: calc(var(--nav-h) + 1rem); }
  .tl__head { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; margin-bottom: 2.5rem; }
  .tl__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem 2rem; }
  @media (min-width: 640px) { .tl__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .tl__grid { grid-template-columns: repeat(3, 1fr); } .tl__head { flex-direction: row; align-items: flex-end; justify-content: space-between; } .tl__head .lede { max-width: 32ch; } }
</style>
