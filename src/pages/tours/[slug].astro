---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import StopsGallery from '@/components/StopsGallery.astro';
import FactList from '@/components/FactList.astro';
import TourCard from '@/components/TourCard.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import { tours, toursFor, peso, type Tour } from '@/data/tours';
import { destinationBySlug } from '@/data/destinations';
import { site } from '@/data/site';

export function getStaticPaths() {
  return tours.map((t) => ({ params: { slug: t.slug }, props: { tour: t } }));
}
const { tour } = Astro.props as { tour: Tour };
const dest = destinationBySlug(tour.destination);
const related = toursFor(tour.destination).filter((t) => t.slug !== tour.slug).slice(0, 3);
const bookHref = `/book?trip=${encodeURIComponent(tour.name)}`;
---

<Base title={tour.name} description={`${tour.name}: ${tour.description}`}>
  <PageHero morph={`tour-${tour.slug}`} image={tour.hero} alt={`${tour.name} — ${tour.stops[0]?.name ?? dest.name}`} title={tour.name} lede={tour.tagline}>
    <div class="td__hero-ctas" data-reveal>
      <a href={bookHref} class="btn">Book now</a>
      <a href="#details" class="btn btn-ghost">Tour details</a>
    </div>
  </PageHero>

  <section class="td section" id="details" data-nav-theme="dark">
    <div class="container grid-12">
      <div class="td__main" data-reveal-group>
        <p class="lede td__desc" data-reveal>{tour.description}</p>

        <div class="td__highlights" data-reveal>
          <p class="eyebrow">Highlights</p>
          <ol class="td__stops">
            {tour.stops.map((s, i) => (
              <li><span class="td__stopnum">{String(i + 1).padStart(2, '0')}</span>{s.name}</li>
            ))}
          </ol>
        </div>

        {tour.activities && (
          <p class="td__activities" data-reveal>
            <span class="eyebrow">Activities</span>
            {tour.activities.join(' · ')}
          </p>
        )}
      </div>

      <aside class="td__aside" data-reveal>
        <div class="td__box">
          <p class="td__price">
            {tour.price ? (
              <>
                <span class="td__promo">{peso(tour.price.promo)}</span>
                <span class="td__orig">{peso(tour.price.original)}</span>
                <span class="td__per">per person, promo rate</span>
              </>
            ) : (
              <span class="td__per td__per--lg">{tour.priceNote ?? 'Ask for current rates'}</span>
            )}
          </p>
          <dl class="td__facts">
            <div><dt>Duration</dt><dd>{tour.duration}</dd></div>
            {tour.pickup && <div><dt>Pick-up</dt><dd>{tour.pickup}</dd></div>}
            <div><dt>Destination</dt><dd><a href={`/destinations/${dest.slug}`}>{dest.name}</a></dd></div>
            <div><dt>Type</dt><dd>{tour.kind}</dd></div>
          </dl>
          <a href={bookHref} class="btn btn-dark td__book">Book this tour</a>
          <a href={`tel:${site.phoneIntl}`} class="td__call">or call {site.phone}</a>
        </div>
      </aside>
    </div>
  </section>

  <StopsGallery items={tour.stops} title="Where you will go" eyebrow="The stops" />

  <section class="td-inc section off" data-nav-theme="dark">
    <div class="container td-inc__grid" data-reveal-group>
      <div data-reveal><FactList title="What's included" items={tour.included} tone="yes" /></div>
      <div data-reveal><FactList title="Not included" items={tour.notIncluded} tone="no" /></div>
      {tour.notes && <div data-reveal><FactList title="Good to know" items={tour.notes} /></div>}
    </div>
  </section>

  {related.length > 0 && (
    <section class="td-rel section" data-nav-theme="dark">
      <div class="container">
        <header class="td-rel__head" data-reveal-group>
          <p class="eyebrow" data-reveal>More in {dest.name}</p>
          <h2 class="display display-m" data-reveal>Other days out.</h2>
        </header>
        <div class="td-rel__grid" data-reveal-group>
          {related.map((t) => <div data-reveal><TourCard tour={t} sizes="(min-width: 960px) 30vw, 100vw" /></div>)}
        </div>
      </div>
    </section>
  )}

  <FinalCTA title={`Book ${tour.name}`} text="Send us your dates and group size. We confirm within the day." cta="Book now" href={bookHref} image={tour.stops[1]?.image ?? tour.hero} alt={tour.stops[1]?.name ?? tour.name} />
</Base>

<style>
  .td__hero-ctas { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .75rem; }
  .td__main { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 2.5rem; }
  .td__desc { max-width: 52ch; font-size: clamp(1.15rem, 1.7vw, 1.5rem); color: var(--ink); }
  .td__highlights .eyebrow { display: block; margin-bottom: 1rem; }
  .td__stops { display: grid; grid-template-columns: 1fr; gap: 0; }
  .td__stops li { display: flex; align-items: baseline; gap: 1rem; padding: .9rem 0; border-top: 1px solid var(--line); font-size: 1.15rem; font-weight: 500; }
  .td__stops li:last-child { border-bottom: 1px solid var(--line); }
  .td__stopnum { font-size: .7rem; letter-spacing: .18em; color: var(--ocean); font-weight: 700; }
  .td__activities { display: flex; flex-direction: column; gap: .5rem; color: var(--ink-2); }
  .td__aside { grid-column: 1 / -1; }
  .td__box { border: 1px solid var(--line); padding: 1.75rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .td__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; }
  .td__promo { font-size: 2rem; font-weight: 700; letter-spacing: -.02em; }
  .td__orig { text-decoration: line-through; opacity: .5; }
  .td__per { font-size: .85rem; color: var(--ink-3); width: 100%; }
  .td__per--lg { font-size: 1.05rem; color: var(--ink); font-weight: 600; }
  .td__facts { display: flex; flex-direction: column; margin: 0; }
  .td__facts div { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-top: 1px solid var(--line); font-size: .92rem; }
  .td__facts dt { color: var(--ink-3); }
  .td__facts dd { margin: 0; text-align: right; font-weight: 500; }
  .td__facts a { text-decoration: underline; text-underline-offset: 3px; }
  .td__book { justify-content: center; }
  .td__call { text-align: center; font-size: .85rem; color: var(--ink-3); }
  .td-inc__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  .td-rel__head { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.5rem; }
  .td-rel__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem 2rem; }
  @media (min-width: 720px) { .td-inc__grid { grid-template-columns: repeat(3, 1fr); gap: 3rem; } .td-rel__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px) {
    .td__main { grid-column: 1 / 8; }
    .td__aside { grid-column: 9 / -1; position: sticky; top: calc(var(--nav-h) + 1.5rem); align-self: start; }
    .td__stops { grid-template-columns: 1fr 1fr; column-gap: 2rem; }
  }
</style>
