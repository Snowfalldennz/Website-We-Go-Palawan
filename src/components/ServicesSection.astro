---
const services = [
  {
    n: '01',
    name: 'Tours',
    text: 'Island hopping, land tours, city tours and firefly watching in El Nido, Coron, Port Barton and Puerto Princesa. Joining tours at promo rates, or private tours for your group.',
    link: { href: '/tours', label: 'Browse tours' },
  },
  {
    n: '02',
    name: 'Van transfers',
    text: 'Air-conditioned 12 to 13 seater vans between Puerto Princesa Airport, El Nido, Port Barton and your hotel. Hotel pick-up is included with every tour in the city.',
    link: { href: '/book?trip=Van%20transfer', label: 'Ask about a transfer' },
  },
  {
    n: '03',
    name: 'Accommodation',
    text: 'Clean, air-conditioned rooms with breakfast in town, a short walk from the beach and restaurants. Bundled into our complete packages, or arranged on their own.',
    link: { href: '/packages', label: 'See packages' },
  },
];
---

<section class="services section" data-bg="#ffffff" id="services" data-nav-theme="dark">
  <div class="container">
    <header class="services__head" data-reveal-group>
      <p class="eyebrow" data-reveal>Services</p>
      <h2 class="display display-l" data-split>Three things, done well.</h2>
    </header>

    <div class="services__grid" data-reveal-group>
      {services.map((s) => (
        <article class="service" data-reveal>
          <span class="service__num">{s.n}</span>
          <h3 class="service__name display display-s">{s.name}</h3>
          <p class="service__text">{s.text}</p>
          <a href={s.link.href} class="link-arrow">{s.link.label} <span class="arrow">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services__head { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .services__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  .service { border-top: 1px solid var(--navy); padding-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .service__num { font-size: .72rem; letter-spacing: .2em; color: var(--ocean); font-weight: 700; }
  .service__text { color: var(--ink-2); text-wrap: pretty; max-width: 38ch; }
  .service .link-arrow { margin-top: .5rem; color: var(--navy); }
  @media (min-width: 720px) { .services__grid { grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); } }
</style>
