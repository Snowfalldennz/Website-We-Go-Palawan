---
import TourCard from './TourCard.astro';
import { featuredTours } from '@/data/tours';
---

<section class="tours dark" data-bg="#071a24" id="tours" data-nav-theme="light" data-tours>
  <div class="tours__pin" data-tours-pin>
    <header class="tours__head container" data-reveal-group>
      <div>
        <p class="eyebrow" data-reveal>Tours</p>
        <h2 class="display display-l" data-split>Days on the water.</h2>
      </div>
      <div class="tours__aside" data-reveal>
        <p class="lede">Island hopping in every destination, plus land, city and evening tours. Promo rates, lunch included on most.</p>
        <a href="/tours" class="link-arrow">All tours <span class="arrow">→</span></a>
      </div>
    </header>

    <div class="tours__track hscroll" data-tours-track>
      {featuredTours.map((t, i) => (
        <div class="tours__item" style={`--i:${i}`}>
          <TourCard tour={t} dark sizes="(min-width: 960px) 26vw, 74vw" />
        </div>
      ))}
      <a href="/tours" class="tours__more">
        <span class="display display-s">See every tour</span>
        <span class="link-arrow">Browse all <span class="arrow">→</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .tours { position: relative; }
  .tours__pin { padding-block: clamp(4rem, 9vw, 8rem) 0; }
  .tours__head { display: flex; flex-direction: column; gap: 2rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .tours__aside { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .tours__aside .lede { max-width: 30ch; }

  .tours__track { padding-bottom: clamp(4rem, 9vw, 8rem); }
  .tours__item { width: min(74vw, 340px); }
  .tours__more {
    width: min(74vw, 340px); align-self: stretch;
    display: flex; flex-direction: column; justify-content: center; gap: 1rem;
    border: 1px solid var(--line-light); padding: 2rem; color: var(--white);
  }

  @media (min-width: 960px) {
    .tours__head { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .tours__pin { height: 100vh; display: flex; flex-direction: column; justify-content: center; padding-block: 0; }
    .tours__track { overflow: visible; scroll-snap-type: none; padding-bottom: 0; will-change: transform; }
    .tours__item { width: 26vw; max-width: 420px; }
    .tours__more { width: 22vw; max-width: 360px; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion, onPage, onLeave } from '@/scripts/motion';

  onPage(() => {
    const section = document.querySelector<HTMLElement>('[data-tours]');
    const pin = section?.querySelector<HTMLElement>('[data-tours-pin]');
    const track = section?.querySelector<HTMLElement>('[data-tours-track]');
    const mq = window.matchMedia('(min-width: 960px)');
    if (!section || !pin || !track || reducedMotion) return;
    let tween: gsap.core.Tween | null = null;

    const build = () => {
      tween?.scrollTrigger?.kill();
      tween?.kill();
      gsap.set(track, { x: 0 });
      if (!mq.matches) return;

      const distance = () => track.scrollWidth - window.innerWidth + parseFloat(getComputedStyle(track).paddingLeft);
      tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          pin: pin,
          start: 'top top',
          end: () => '+=' + distance() * 1.1,
          scrub: 0.6,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });
    };

    build();
    const onBreakpoint = () => { build(); ScrollTrigger.refresh(); };
    mq.addEventListener('change', onBreakpoint);
    onLeave(() => mq.removeEventListener('change', onBreakpoint));
  });
</script>
